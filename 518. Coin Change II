class Solution {
    public int change(int amount, int[] coins) {
        int n=coins.length;
        int[][] dp=new int[n][amount+1];
        for(int i=0;i<=amount;i++)
        {
            if (i%coins[0]==0)
            {
                dp[0][i]=1;
            }
            else
            {
                dp[0][i]=0;
            }
            
        }
        for(int i=1;i<n;i++)
        {
            for(int t=0;t<=amount;t++)
            {
                int nottake=dp[i-1][t];
                int take=0;
                if(coins[i]<=t)
                {
                    take=dp[i][t-coins[i]];
                }
                dp[i][t]=nottake+take;
            }
        }
        int ans=dp[n-1][amount];
        if(ans>=Integer.MAX_VALUE)
        {
            return -1;
        }
        return ans;
    }
}
