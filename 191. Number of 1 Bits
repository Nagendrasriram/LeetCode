class Main {
    public static void main(String[] args) {
        int n=11,cnt=0;
        String ans="";
        while(n>0)
        {
            ans=(n&1)+ans;
            n=n>>1;
        }
        for(int i=0;i<ans.length();i++)
        {
            if(ans.charAt(i)=='1')
            {
                cnt++;
            }
        }
        System.out.print(cnt);
    }
}
